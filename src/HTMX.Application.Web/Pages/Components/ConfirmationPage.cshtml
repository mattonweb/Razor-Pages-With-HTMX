@page "/components/confirmation-page"
@model HTMX.Application.Web.Pages.Components.ConfirmationPageModel
@{
    ViewData["Title"] = "Confirmation page";
    ViewData["Section"] = "Components";
}
<header class="page-header">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol><li><a asp-page="/Index">Home</a></li><li><a asp-page="./Index">Components</a></li><li><span aria-current="page">Confirmation page</span></li></ol>
    </nav>
    <div class="title-row">
        <h1 tabindex="-1" autofocus="@Model.HeadingFocused">Confirmation page</h1>
    </div>
    <p class="muted">
        Files that a delete removes for good, so each Delete asks first: in a dialog where the browser has invoker
        commands, and on a page of its own in any other browser, or with script off.
    </p>
</header>

@* The list is a partial: the page draws it here, and a change's answer draws it alone. *@
<partial name="_SavedFileList" model="Model" />

@* A change without HTMX, or from the confirmation page, is redirected back here, and the toast it left shows. *@
@section Toasts {
    @if (Model.Toast is Toast toast)
    {
        <partial name="_Toast" model="toast" />
    }
}
