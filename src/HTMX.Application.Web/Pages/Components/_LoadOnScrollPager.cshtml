@model HTMX.Application.Web.Pages.Components.LoadOnScrollModel
@using System.Globalization
@using HTMX.Adapter.Customers.Contracts
@*
    The pager above the list: how many rows show, of how many, and Load more. Without HTMX, Load more is a link to the
    address that shows ten more, at the first of them. With HTMX it asks for the ten after the last row, as the last row
    does when it comes into view; both share the table body's queue (hx-sync), which drops a second request while the
    first is on its way. Each load draws the pager again, and Load more keeps its id, so a keyboard on it stays there.
    The list stops at a hundred rows, where the pager says where the rest are.
*@
@{
    int next = Model.Shown + GrowingListModel.Step;
    string? page = Url.Page("./LoadOnScroll", new { shown = next });
    string? more = Url.Page("./LoadOnScroll", new { shown = next, after = Model.Last });
    bool room = next <= PageSize.Largest;
    string shown = Model.Shown.ToString("N0", CultureInfo.CurrentCulture);
    string matching = Model.Matching.ToString("N0", CultureInfo.CurrentCulture);
}
<div pager id="more-pager">
    <p pager="summary">Showing <strong>@shown</strong> of <strong>@matching</strong></p>
    @if (Model.More && room)
    {
        <a button="secondary" id="more-link" href="@(page)#more-@(Model.Shown + 1)"
           hx-get="@more" hx-target="#more-rows" hx-swap="beforeend" hx-sync="#more-rows:drop">Load more</a>
    }
    else if (Model.More)
    {
        <p pager="summary">
            The list stops at @PageSize.Largest; <a asp-page="/Organizations/Index">the organizations list</a> pages
            through them all.
        </p>
    }
</div>
