@model HTMX.Application.Web.Pages.Components.GrowingListModel
@using System.Globalization
@using HTMX.Adapter.Customers.Contracts
@using HTMX.Application.Web.Pages.Organizations
@*
    The rows one answer draws. Each has an id by its position, more-1 and on, which the link Load more is without HTMX
    goes to, so the browser shows the first new row. With HTMX the first row a pressed Load more added says autofocus
    on its link, and HTMX puts the keyboard there after the swap, ready to read on from the new rows.

    On a page that grows as it scrolls, the last row asks for the next ten as it comes into view (hx-trigger
    "revealed", which fires once) and adds them after itself, sharing the table body's queue with Load more, so that
    the two never ask for the same ten. Its rows take no keyboard: the user did not ask for them.
*@
@for (int index = 0; index < Model.Rows.Length; index++)
{
    OrganizationSummary organization = Model.Rows[index];
    int position = Model.FirstPosition + index;
    string? grows = index == Model.Rows.Length - 1 ? Model.GrowsFrom : null;
    bool growing = grows is not null;
    <tr id="more-@position" hx-get="@grows" hx-trigger="@(growing ? "revealed" : null)"
        hx-target="@(growing ? "#more-rows" : null)" hx-swap="@(growing ? "beforeend" : null)"
        hx-sync="@(growing ? "#more-rows:drop" : null)">
        <td class="title">
            <a asp-page="/Organizations/Details" asp-route-id="@organization.Id.Value"
               autofocus="@(Model.FirstRowFocused && index == 0)">@organization.Name.Value</a>
        </td>
        <td>@IndustryNames.Of(organization.Industry)</td>
        <td>@organization.Contacts.Value.ToString("N0", CultureInfo.CurrentCulture)</td>
    </tr>
}
