@model HTMX.Application.Web.Pages.Components.NotAllowedModel
@*
    What an action answers HTMX with: the list's card, as the user may now use it, and, for the layout's toast region,
    the toast that says what the action did or why it was refused.
*@
<partial name="_ArticleList" model="Model" />
@if (Model.Toast is Toast toast)
{
    <partial name="_ToastUpdate" model="toast" />
}
