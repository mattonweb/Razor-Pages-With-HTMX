@page "/components/reload-on-event"
@model HTMX.Application.Web.Pages.Components.ReloadOnEventModel
@{
    ViewData["Title"] = "Reload on event";
    ViewData["Section"] = "Components";
}
<header class="page-header">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol><li><a asp-page="/Index">Home</a></li><li><a asp-page="./Index">Components</a></li><li><span aria-current="page">Reload on event</span></li></ol>
    </nav>
    <div class="title-row">
        <h1 tabindex="-1" autofocus="@Model.HeadingFocused">Reload on event</h1>
    </div>
    <p class="muted">
        A note written in the form raises an event, and the list, which listens for it, loads itself again. The board is
        shared by everyone who opens the page, and keeps the newest ten notes.
    </p>
</header>

@* Two cards, each a partial: the page draws both, and HTMX gets each alone. *@
<partial name="_NoteForm" model="Model" />
<partial name="_NoteList" model="Model" />
