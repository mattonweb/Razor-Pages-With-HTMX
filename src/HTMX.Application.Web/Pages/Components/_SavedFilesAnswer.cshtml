@model HTMX.Application.Web.Pages.Components.ConfirmationPageModel
@*
    What a change answers HTMX with: the list's card, as it is now, and, for the layout's toast region, the toast that
    says what changed.
*@
<partial name="_SavedFileList" model="Model" />
@if (Model.Toast is Toast toast)
{
    <partial name="_ToastUpdate" model="toast" />
}
