@model HTMX.Application.Web.Pages.Components.OrderLinesModel
@*
    The order form, in its card. HTMX replaces the card (outerHTML) with what Send answers: the card with 422 when a
    line is wrong, each wrong field marked and the first taking the keyboard, or a new card and a toast once the order
    is received. The lines are a partial of their own, which Add and Remove answer HTMX with (_OrderLines).
*@
@{
    string? action = Url.Page("./OrderLines");
}
<section class="card" id="order-form" aria-labelledby="order-form-heading">
    <header class="card-header"><h2 id="order-form-heading">An order</h2></header>
    <form method="post" action="@action" asp-antiforgery="true" novalidate
          hx-post="@action" hx-target="#order-form" hx-swap="outerHTML"
          hx-indicator="find .form-actions button[type=submit]" hx-disable="find .form-actions button[type=submit]">
        <div class="card-body fields">
            <partial name="_OrderLines" model="Model" />
        </div>
        <div class="form-actions">
            <div class="end">
                <button class="btn primary" type="submit">Send the order</button>
            </div>
        </div>
    </form>
</section>
