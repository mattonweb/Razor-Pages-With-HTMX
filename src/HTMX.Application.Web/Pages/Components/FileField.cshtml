@page "/components/file-field"
@model HTMX.Application.Web.Pages.Components.FileFieldModel
@{
    ViewData["Title"] = "File field";
    ViewData["Section"] = "Components";
}
@* The page's route is written out, so its address reads /components/file-field rather than /components/filefield. *@
<header class="page-header">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol><li><a asp-page="/Index">Home</a></li><li><a asp-page="./Index">Components</a></li><li><span aria-current="page">File field</span></li></ol>
    </nav>
    <div class="title-row">
        <h1 tabindex="-1" autofocus="@Model.HeadingFocused">File field</h1>
    </div>
    <p class="muted">A form that sends a title and a file, and says what it received. It keeps nothing.</p>
</header>

@* The form's card is a partial: the page draws it here, and a refused form that HTMX sent gets it alone. *@
<partial name="_FileFieldForm" model="Model" />

@* A file received without HTMX is redirected back here, and the toast it left shows. *@
@section Toasts {
    @if (Model.Toast is Toast toast)
    {
        <partial name="_Toast" model="toast" />
    }
}
