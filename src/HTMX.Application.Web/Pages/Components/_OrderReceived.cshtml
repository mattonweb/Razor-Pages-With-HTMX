@model HTMX.Application.Web.Pages.Components.OrderLinesModel
@*
    What an order received answers HTMX with: a new form, its first line's product taking the keyboard, and, for the
    layout's toast region, the toast that says what order came.
*@
<partial name="_OrderForm" model="Model" />
@if (Model.Toast is Toast toast)
{
    <partial name="_ToastUpdate" model="toast" />
}
