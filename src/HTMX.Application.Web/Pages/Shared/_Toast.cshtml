@model HTMX.Application.Web.Pages.Toast
@*
    One toast, for the layout's #toasts region. Undo is a real form that posts the undo, with HTMX or without it; with
    HTMX it replaces UndoTarget. Its button keeps the id toast-undo, so that HTMX puts the focus back on the next
    toast's Undo when the response replaces this one. The toast leaves by itself after 8 seconds (animate-toast), its
    fade waiting while the pointer or the keyboard is on it; app.js removes it then, or when Dismiss is pressed, and
    finds it by data-toast rather than by the classes that style it. Undo and Dismiss take the ghost looks made for an
    inverse surface. In forced colors its face and shadow are gone, so it takes a border to keep its edge.
*@
<div class="pointer-events-auto flex min-h-11 animate-toast items-center gap-3 rounded-md bg-inverse py-2 pr-2 pl-4 text-on-inverse shadow-popup forced-colors:border hover:[animation-play-state:running,paused] focus-within:[animation-play-state:running,paused]" data-toast>
    <span class="flex-1">@Model.Message</span>
    @if (Model.UndoAction is string undo)
    {
        <form method="post" action="@undo" asp-antiforgery="true"
              hx-post="@undo" hx-target="@Model.UndoTarget" hx-swap="outerHTML">
            <button button="ghost-inverse" id="toast-undo" type="submit">Undo</button>
        </form>
    }
    <button button="icon-inverse" type="button" data-action="dismiss-toast" aria-label="Dismiss"><icon name="x" /></button>
</div>
