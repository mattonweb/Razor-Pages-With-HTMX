@model HTMX.Application.Web.Pages.Contacts.DetailsModel
@using HTMX.Adapter.Customers.Contracts
@*
    The Details tab's content: the contact's header and every value they hold. HTMX replaces #contact whole
    (outerHTML) with it after Archive, Restore or Undo on this tab, as part of _RecordChanged. The organization is a
    related-record link, muted and followed by a chip while the organization is archived.
*@
@{
    ContactSingleResponse contact = Model.Contact
        ?? throw new InvalidOperationException("The Details tab needs the contact.");
    OrganizationReference organization = contact.Organization;
    RecordChange created = contact.Created;
}
<div id="contact">
    <partial name="_ContactHeader" model="Model" />

    <section card aria-labelledby="details-heading">
        <header card="header"><h2 id="details-heading">Details</h2></header>
        <div card="body">
            <dl fields>
                <div>
                    <dt>Organization</dt>
                    <dd>
                        <a related="@(organization.ArchivedOn is null ? string.Empty : "archived")" asp-page="/Organizations/Details" asp-route-id="@organization.Id.Value"><icon name="building" size="sm" />@organization.Name.Value</a>
                        @if (organization.ArchivedOn is not null)
                        {
                            <span chip="neutral" class="ml-2">Archived</span>
                        }
                    </dd>
                </div>
                <div>
                    <dt>Job title</dt>
                    @if (contact.JobTitle is JobTitle jobTitle)
                    {
                        <dd>@jobTitle.Value</dd>
                    }
                    else
                    {
                        <dd><span class="text-fg-muted">Not set</span></dd>
                    }
                </div>
                <div>
                    <dt>Email</dt>
                    @if (contact.Email is EmailAddress email)
                    {
                        <dd><a href="mailto:@email.Value">@email.Value</a></dd>
                    }
                    else
                    {
                        <dd><span class="text-fg-muted">Not set</span></dd>
                    }
                </div>
                <div>
                    @* One term, and a description for each number, in the order they were written. *@
                    <dt>Phone numbers</dt>
                    @foreach (PhoneNumber phone in contact.PhoneNumbers.Values)
                    {
                        <dd>@phone.Value</dd>
                    }
                    @if (contact.PhoneNumbers.Values.Length == 0)
                    {
                        <dd><span class="text-fg-muted">Not set</span></dd>
                    }
                </div>
                <div><dt>Identifier</dt><dd class="font-mono text-[0.93em]">@contact.Id.Value</dd></div>
                <div><dt>Created</dt><dd><partial name="_Moment" model="created.On" /> by <partial name="_UserLink" model="created.By" /></dd></div>
                @if (contact.Archived is RecordChange archived)
                {
                    <div><dt>Archived</dt><dd><partial name="_Moment" model="archived.On" /> by <partial name="_UserLink" model="archived.By" /></dd></div>
                }
                <div class="col-span-full">
                    <dt>Notes</dt>
                    @if (contact.Notes is Notes notes)
                    {
                        <dd>@notes.Value</dd>
                    }
                    else
                    {
                        <dd><span class="text-fg-muted">Not set</span></dd>
                    }
                </div>
            </dl>
        </div>
    </section>
</div>
