@page
@model HTMX.Application.Web.Pages.Contacts.CreateModel
@using HTMX.Adapter.Customers.Contracts
@{
    ViewData["Title"] = "New contact";
    ViewData["Section"] = "Organizations";
}
@* The breadcrumbs lead back through the organization the form was opened from, when there is one. *@

<header class="page-header">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
            <li><a asp-page="/Index">Home</a></li>
            <li><a asp-page="/Organizations/Index">Organizations</a></li>
            @if (Model.OpenedFrom is OrganizationSingleResponse from)
            {
                <li><a asp-page="/Organizations/Details" asp-route-id="@from.Id.Value">@from.Name.Value</a></li>
                <li><a asp-page="/Organizations/Contacts" asp-route-id="@from.Id.Value">Contacts</a></li>
            }
            <li><span aria-current="page">New contact</span></li>
        </ol>
    </nav>
    <div class="title-row"><h1>New contact</h1></div>
</header>

@* The form is a partial: the page renders it here, and a refused save that HTMX sent gets it alone. *@
<partial name="_ContactCreateForm" model="Model" />
