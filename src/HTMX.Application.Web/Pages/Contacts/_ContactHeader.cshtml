@model HTMX.Application.Web.Pages.Contacts.ContactPageModel
@using HTMX.Adapter.Customers.Contracts
@*
    The top of every tab of a contact's page: its header, the alert that says why the contact can't be changed, and
    the tabs. The breadcrumbs lead back through the contact's organization to its Contacts tab. Archive and Restore
    post to the current tab's own handlers, with HTMX or without it, so the answer is that tab again; their buttons
    share the id status-action, so that HTMX puts the focus back on whichever the new content holds, and neither says
    hx-disable, which would lose it. Edit goes to the contact's edit form. An archived contact offers Restore in the
    alert and no Edit; while the contact's organization is archived, the contact can't be changed, so the page offers
    none of them.

    Delete permanently, last in an archived contact's alert, asks first in the brand's confirm dialog, as a user's and
    an organization's do: a native <dialog> opened with commandfor, holding its own form, which posts to the tab's
    Delete handler with the version it shows, with HTMX or without it. A deleted contact's page goes to their
    organization's Contacts tab; a refused delete answers like Archive, and the answer replaces #contact, the dialog
    with it. Nothing but their own history names a contact, so there is no dialog for a delete that is not allowed.
*@
@{
    ContactSingleResponse contact = Model.Contact
        ?? throw new InvalidOperationException("The contact's header needs the contact.");
    OrganizationReference organization = contact.Organization;
    RecordChange lastChange = contact.LastModified;
    long id = contact.Id.Value;
    string name = contact.Name.Value;
    long organizationId = organization.Id.Value;
    bool organizationActive = organization.ArchivedOn is null;
    string? archiveAction = Url.Page(Model.PageName, "Archive", Model.TabValues());
    string? restoreAction = Url.Page(Model.PageName, "Restore", Model.TabValues());
    string? deleteAction = Url.Page(Model.PageName, "Delete", Model.TabValues());
}
<header class="page-header">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
            <li><a asp-page="/Index">Home</a></li>
            <li><a asp-page="/Organizations/Index">Organizations</a></li>
            <li><a asp-page="/Organizations/Details" asp-route-id="@organizationId">@organization.Name.Value</a></li>
            <li><a asp-page="/Organizations/Contacts" asp-route-id="@organizationId">Contacts</a></li>
            <li><span aria-current="page">@contact.Name.Value</span></li>
        </ol>
    </nav>
    <div class="title-row">
        <div class="title">
            <h1>@contact.Name.Value</h1>
            @if (contact.Archived is null)
            {
                <span class="chip success">Active</span>
            }
            else
            {
                <span class="chip">Archived</span>
            }
            <span class="version current">v@(contact.Version.Value)</span>
        </div>
        @if (organizationActive && contact.Archived is null)
        {
            <div class="btn-group">
                <form method="post" action="@archiveAction" asp-antiforgery="true"
                      hx-post="@archiveAction" hx-target="#contact" hx-swap="outerHTML"
                      hx-indicator="find button">
                    <button class="btn" id="status-action" type="submit"><svg class="icon" aria-hidden="true"><use href="/icons.svg#archive"></use></svg>Archive</button>
                </form>
                <a class="btn primary" asp-page="./Edit" asp-route-id="@id"><svg class="icon" aria-hidden="true"><use href="/icons.svg#edit"></use></svg>Edit</a>
            </div>
        }
    </div>
    <p class="muted">Updated <partial name="_Moment" model="lastChange.On" /> by <partial name="_UserLink" model="lastChange.By" /></p>
</header>

@if (!organizationActive)
{
    <div class="alert" role="status">
        <svg class="icon" aria-hidden="true"><use href="/icons.svg#archive"></use></svg>
        <div class="content"><p><strong>@organization.Name.Value is archived.</strong> Its contacts can't be changed until it is restored.</p></div>
        <div class="actions">
            <a class="btn" asp-page="/Organizations/Details" asp-route-id="@organizationId"><svg class="icon" aria-hidden="true"><use href="/icons.svg#building"></use></svg>Go to @organization.Name.Value</a>
        </div>
    </div>
}
else if (contact.Archived is not null)
{
    <div class="alert" role="status">
        <svg class="icon" aria-hidden="true"><use href="/icons.svg#archive"></use></svg>
        <div class="content"><p><strong>This contact is archived.</strong> They stay on the Contacts tab of @organization.Name.Value, muted, and can't be edited or rolled back until they are restored.</p></div>
        <div class="actions">
            <form method="post" action="@restoreAction" asp-antiforgery="true"
                  hx-post="@restoreAction" hx-target="#contact" hx-swap="outerHTML"
                  hx-indicator="find button">
                <button class="btn" id="status-action" type="submit"><svg class="icon" aria-hidden="true"><use href="/icons.svg#restore"></use></svg>Restore</button>
            </form>
            <button class="btn danger" type="button" commandfor="delete-contact" command="show-modal"><svg class="icon" aria-hidden="true"><use href="/icons.svg#trash"></use></svg>Delete permanently</button>
        </div>
    </div>

    <dialog class="dialog sm" id="delete-contact" aria-labelledby="delete-contact-title" aria-describedby="delete-contact-text">
        <form method="post" action="@deleteAction" asp-antiforgery="true"
              hx-post="@deleteAction" hx-target="#contact" hx-swap="outerHTML"
              hx-indicator="find button[type=submit]" hx-disable="find button[type=submit]">
            <input type="hidden" name="version" value="@contact.Version.Value" />
            <header class="dialog-header"><h2 id="delete-contact-title">Delete @name permanently?</h2></header>
            <div class="dialog-body confirm">
                <span class="dialog-icon"><svg class="icon" aria-hidden="true"><use href="/icons.svg#trash"></use></svg></span>
                <div class="message" id="delete-contact-text"><p>This removes @name and their history, and takes them off the Contacts tab of @organization.Name.Value. It cannot be undone.</p></div>
            </div>
            <footer class="dialog-footer">
                <button class="btn" type="button" commandfor="delete-contact" command="close" autofocus>Cancel</button>
                <button class="btn danger" type="submit">Delete permanently</button>
            </footer>
        </form>
    </dialog>
}

@* Each tab is a page with its own URL; the count after History is how many versions the contact has. *@
<nav class="tabs" aria-label="Contact">
    <a asp-page="./Details" asp-route-id="@id" aria-current="@(Model.PageName == "./Details" ? "page" : null)">Details</a>
    <a asp-page="./History" asp-route-id="@id" aria-current="@(Model.PageName == "./History" ? "page" : null)">History <span class="count">@contact.Version.Value</span></a>
</nav>
