@model HTMX.Application.Web.Pages.Organizations.DetailsModel
@*
    What HTMX gets after Archive, Restore or Undo: the page's content, which replaces #organization-details, and the
    toast, which replaces whatever the layout's #toasts region holds, so an Undo never outlives the action it undoes.
    HTMX 4 turns <hx-partial> into a template, swaps the main content first and then each partial into its own
    hx-target (4.0.1 source, #makeFragment and #processPartials); Razor writes the element through as it is.
*@
<partial name="_OrganizationDetails" model="Model" />
@if (Model.Toast is Toast toast)
{
    <hx-partial hx-target="#toasts" hx-swap="innerHTML">
        <partial name="_Toast" model="toast" />
    </hx-partial>
}
