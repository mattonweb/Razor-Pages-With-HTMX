@page
@model HTMX.Application.Web.Pages.Organizations.IndexModel
@{
    ViewData["Title"] = "Organizations";
    ViewData["Section"] = "Organizations";
}

<header class="page-header">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol><li><a asp-page="/Index">Home</a></li><li><span aria-current="page">Organizations</span></li></ol>
    </nav>
    <div class="title-row">
        <h1 tabindex="-1" autofocus="@Model.HeadingFocused">Organizations</h1>
        <a class="btn primary" asp-page="./Create"><svg class="icon" aria-hidden="true"><use href="/icons.svg#plus"></use></svg>New organization</a>
    </div>
</header>

@* The list's card is a partial: the page renders it here, and the handler sends it alone to an HTMX request. *@
<partial name="_OrganizationList" model="Model" />

@* The toast another page left shows here: after an organization is deleted, its page comes here, by a redirect or by
   HX-Location, and after an action on a row without HTMX, the redirect does. *@
@section Toasts {
    @if (Model.Toast is Toast toast)
    {
        <partial name="_Toast" model="toast" />
    }
}
