@model HTMX.Application.Web.Pages.Organizations.CreateModel
@*
    The create form. HTMX replaces it whole (outerHTML, hx-target="this") when a save it sent is refused:
    CreateModel.OnPostAsync answers with it, with 422, and HTMX 4 swaps that status like any other. Nothing outside
    the form changes when a save is refused. A save that succeeds answers with no content, and HX-Location loads the
    new organization's page.
*@
@{
    string? action = Url.Page("./Create");
    OrganizationFields fields = new OrganizationFields { Input = Model.Input };
}
<form id="organization-create" method="post" action="@action" asp-antiforgery="true" novalidate
      hx-post="@action" hx-target="this" hx-swap="outerHTML"
      hx-indicator="find button[type=submit]" hx-disable="find button[type=submit]">
    <partial name="_OrganizationFields" model="fields" />

    @* TEMPORARY, 2026-11-10: padding that makes the form longer than the window, to see where the focus goes after a
       refused save. The fields are optional and bind to nothing. Remove this card; do not commit it. *@
    <section class="card" aria-labelledby="padding-heading">
        <header class="card-header"><h2 id="padding-heading">Temporary padding</h2></header>
        <div class="card-body fields">
            @for (int number = 1; number <= 40; number++)
            {
                <div class="field">
                    <label for="padding-@number">Padding field @number</label>
                    <input id="padding-@number" name="Padding@(number)" />
                </div>
            }
        </div>
    </section>

    <div class="form-actions">
        <div class="end">
            <a class="btn" asp-page="./Index">Cancel</a>
            <button class="btn primary" type="submit">Create organization</button>
        </div>
    </div>
</form>
