@model HTMX.Application.Web.Pages.Organizations.OrganizationPageModel
@*
    What HTMX gets after an action on the organization, on any tab of its page: the tab's content, which replaces
    #organization, and the toast, which replaces whatever the layout's #toasts region holds.
*@
<partial name="@Model.ContentPartial" model="Model" />
@if (Model.Toast is Toast toast)
{
    <partial name="_ToastUpdate" model="toast" />
}
