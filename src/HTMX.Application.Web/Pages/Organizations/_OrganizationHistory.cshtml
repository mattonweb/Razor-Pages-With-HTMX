@model HTMX.Application.Web.Pages.Organizations.HistoryModel
@*
    The History tab's content: the organization's header and its versions in the shared timeline. HTMX replaces
    #organization whole (outerHTML) with it after Archive, Restore, a roll-back or Undo on this tab, as part of
    _RecordChanged, so the new version is at the top of the timeline when the toast arrives.
*@
@{
    Timeline timeline = Model.Timeline
        ?? throw new InvalidOperationException("The History tab needs the organization's versions.");
}
<div id="organization">
    <partial name="_OrganizationHeader" model="Model" />

    <section class="card" aria-labelledby="history-heading">
        <header class="card-header"><h2 id="history-heading">History</h2></header>
        <div class="card-body">
            <partial name="_Timeline" model="timeline" />
        </div>
    </section>
</div>
