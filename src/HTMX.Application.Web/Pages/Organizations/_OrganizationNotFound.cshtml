@model long
@*
    What an organization's pages show for an identifier that names no organization, inside the application's frame.
    The page that renders it also sets the status 404 Not Found. Its model is the identifier from the route.
*@
<header class="page-header">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol><li><a asp-page="/Index">Home</a></li><li><a asp-page="./Index">Organizations</a></li><li><span aria-current="page">Not found</span></li></ol>
    </nav>
    <div class="title-row"><h1>Organization not found</h1></div>
</header>

<div class="card">
    <div class="empty">
        <svg class="icon" aria-hidden="true"><use href="/icons.svg#building"></use></svg>
        <h3>No organization has the identifier @Model</h3>
        <p>It may have been deleted, or the link may be mistyped.</p>
        <a class="btn" asp-page="./Index">Back to organizations</a>
    </div>
</div>
