@model HTMX.Application.Web.Pages.Organizations.IndexModel
@using System.Globalization
@using HTMX.Adapter.Customers.Contracts
@{
    OrganizationCollectionResponse list = Model.Organizations;
    OrganizationCollectionRequest current = list.Request;
}
@* Every link and form in the card loads over HTMX: the response replaces the card itself, the URL follows, and
   the card shows the busy bar while a request is in flight. In HTMX 4 an attribute reaches the card's descendants
   only when it says :inherited, and "this" means the card that declares it. Every request in the card joins one
   queue on the card, and the newest replaces the one running, so a slow answer to an older filter, sort or page never
   lands after a newer one; without hx-sync each element would keep its own queue, and HTMX 4 drops a third request
   while one runs and one waits. Without HTMX they are plain links and GET forms.

   Each row's menu archives or restores its organization: a form that posts to the list's own address, with the
   handler and the organization added, with HTMX or without it. It says hx-post, which HTMX sets up before it boosts
   anything, so the post is not boosted, and it inherits the card as its target and the card's queue. In the Active or
   Archived view the row leaves the list and the counts change, which the card holds too. Once the answer has drawn
   the card again, HTMX focuses the one element that says autofocus: the row's menu button, the menu button of the row
   now in its place, or the empty list's heading. *@
<div class="card" id="organization-list"
     hx-boost:inherited="true" hx-target:inherited="this" hx-swap:inherited="outerHTML"
     hx-indicator:inherited="#organization-list" hx-sync:inherited="this:replace">
    <div class="toolbar">
        @* A GET form: typing a filter and pressing Enter loads the list again, keeping the status, sort and page size.
           Apply sends it too; the brand's CSS shows it only without HTMX, for a pointer. *@
        <form class="filter-box" role="search" method="get">
            <svg class="icon" aria-hidden="true"><use href="/icons.svg#filter"></use></svg>
            @* As you type, 300ms after the last key; the id lets HTMX keep the cursor in the box across the swap. *@
            <input type="search" id="organization-filter" name="@ListQuery.FilterKey" value="@current.Filter?.Value"
                   placeholder="Filter organizations" aria-label="Filter organizations"
                   hx-get="@Url.Page("./Index")" hx-trigger="input changed delay:300ms, search" hx-include="closest form"
                   hx-push-url="true">
            <input type="hidden" name="@ListQuery.StatusKey" value="@current.Status.ToString().ToLowerInvariant()">
            <input type="hidden" name="@ListQuery.SortKey" value="@current.Sort.ToString().ToLowerInvariant()">
            <input type="hidden" name="@ListQuery.DirectionKey" value="@current.Direction.ToString().ToLowerInvariant()">
            <input type="hidden" name="@ListQuery.PageSizeKey" value="@current.PageSize.Value">
            <button class="btn" type="submit">Apply</button>
        </form>
        <nav class="segmented" aria-label="Show">
            <a asp-page="./Index" asp-all-route-data="Model.RouteValues(status: RecordStatus.Active)"
               aria-current="@(current.Status == RecordStatus.Active ? "page" : null)">Active <span class="count">@list.Active.Value.ToString("N0", CultureInfo.CurrentCulture)</span></a>
            <a asp-page="./Index" asp-all-route-data="Model.RouteValues(status: RecordStatus.Archived)"
               aria-current="@(current.Status == RecordStatus.Archived ? "page" : null)">Archived <span class="count">@list.Archived.Value.ToString("N0", CultureInfo.CurrentCulture)</span></a>
            <a asp-page="./Index" asp-all-route-data="Model.RouteValues(status: RecordStatus.All)"
               aria-current="@(current.Status == RecordStatus.All ? "page" : null)">All <span class="count">@list.All.Value.ToString("N0", CultureInfo.CurrentCulture)</span></a>
        </nav>
    </div>
    <div class="busy-bar"></div>

    @* An empty list says why, naming the view: the filter matched nothing in it, or the view has nothing in it, as
       when the last archived organization is restored. Its heading takes the keyboard when an action took the last
       row away. *@
    @if (list.Matching.Value == 0)
    {
        string which = current.Status == RecordStatus.All ? "organizations" : $"{current.Status.ToString().ToLowerInvariant()} organizations";
        <div class="empty">
            @if (current.Filter is FilterText filter)
            {
                <svg class="icon" aria-hidden="true"><use href="/icons.svg#filter"></use></svg>
                <h3 tabindex="-1" autofocus="@Model.EmptyFocused">No @which match “@filter.Value”</h3>
                <p>Check the spelling, or filter by another word.</p>
                <a class="btn" asp-page="./Index" asp-all-route-data="Model.RouteValues(withoutFilter: true)">Clear filter</a>
            }
            else
            {
                <svg class="icon" aria-hidden="true"><use href="/icons.svg#building"></use></svg>
                <h3 tabindex="-1" autofocus="@Model.EmptyFocused">No @which</h3>
                @switch (current.Status)
                {
                    case RecordStatus.Archived:
                        <p>An organization shows here once it is archived.</p>
                        break;
                    case RecordStatus.All:
                        <p>An organization shows here once it is added.</p>
                        break;
                    default:
                        <p>Archived organizations show under Archived.</p>
                        break;
                }
            }
        </div>
    }
    else
    {
        <div class="grid-wrap">
            <table class="grid">
                <caption class="visually-hidden">Organizations, @current.Status.ToString().ToLowerInvariant(), sorted by @current.Sort.ToString().ToLowerInvariant(), @current.Direction.ToString().ToLowerInvariant()</caption>
                <thead>
                    <tr>
                        <th scope="col" aria-sort="@Model.AriaSort(OrganizationSortColumn.Name)">
                            <a asp-page="./Index" asp-all-route-data="Model.SortRouteValues(OrganizationSortColumn.Name)">Name <partial name="_SortIcon" model="Model.AriaSort(OrganizationSortColumn.Name)" /></a>
                        </th>
                        <th scope="col" aria-sort="@Model.AriaSort(OrganizationSortColumn.Industry)">
                            <a asp-page="./Index" asp-all-route-data="Model.SortRouteValues(OrganizationSortColumn.Industry)">Industry <partial name="_SortIcon" model="Model.AriaSort(OrganizationSortColumn.Industry)" /></a>
                        </th>
                        <th scope="col" class="num" aria-sort="@Model.AriaSort(OrganizationSortColumn.Contacts)">
                            <a asp-page="./Index" asp-all-route-data="Model.SortRouteValues(OrganizationSortColumn.Contacts)">Contacts <partial name="_SortIcon" model="Model.AriaSort(OrganizationSortColumn.Contacts)" /></a>
                        </th>
                        <th scope="col">Status</th>
                        <th scope="col" aria-sort="@Model.AriaSort(OrganizationSortColumn.Updated)">
                            <a asp-page="./Index" asp-all-route-data="Model.SortRouteValues(OrganizationSortColumn.Updated)">Updated <partial name="_SortIcon" model="Model.AriaSort(OrganizationSortColumn.Updated)" /></a>
                        </th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (OrganizationSummary organization in list.Items)
                    {
                        string action = Model.RowAction(organization);
                        string menu = $"organization-{organization.Id.Value}-menu";
                        @* Archived rows are muted only among active ones, in the All view. *@
                        <tr class="@(current.Status == RecordStatus.All && organization.ArchivedOn is not null ? "archived" : null)">
                            <td class="title">
                                @* A link to the organization leaves the list, so it is a normal link, not a swap. *@
                                <a asp-page="./Details" asp-route-id="@organization.Id.Value" hx-boost="false">@organization.Name.Value</a>
                                @if (organization.Website is WebAddress website)
                                {
                                    <span class="sub">@IndexModel.WebsiteHost(website)</span>
                                }
                            </td>
                            <td>@IndustryNames.Of(organization.Industry)</td>
                            <td class="num">@organization.Contacts.Value.ToString("N0", CultureInfo.CurrentCulture)</td>
                            <td>
                                @if (organization.ArchivedOn is null)
                                {
                                    <span class="chip success">Active</span>
                                }
                                else
                                {
                                    <span class="chip">Archived</span>
                                }
                            </td>
                            <td><time datetime="@organization.LastModifiedOn.ToString("O", CultureInfo.InvariantCulture)">@organization.LastModifiedOn.ToLocalTime().ToString("d MMM yyyy", CultureInfo.CurrentCulture)</time></td>
                            @* The row's menu, a popover with an id built from the organization's. *@
                            <td class="actions">
                                <button class="btn ghost icon-only" type="button" popovertarget="@menu"
                                        aria-label="Actions for @organization.Name.Value"
                                        autofocus="@(Model.Focused == organization.Id)">
                                    <svg class="icon" aria-hidden="true"><use href="/icons.svg#more"></use></svg>
                                </button>
                                <div class="menu" id="@menu" popover>
                                    <form method="post" action="@action" asp-antiforgery="true" hx-post="@action">
                                        @if (organization.ArchivedOn is null)
                                        {
                                            <button type="submit"><svg class="icon" aria-hidden="true"><use href="/icons.svg#archive"></use></svg>Archive</button>
                                        }
                                        else
                                        {
                                            <button type="submit"><svg class="icon" aria-hidden="true"><use href="/icons.svg#restore"></use></svg>Restore</button>
                                        }
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* Key-based paging knows the total and whether there is a page either side, not where in the list this page
           starts, so the summary gives the count shown and the total.

           Previous, Next and Rows per page take the page's main content, heading and all, from the whole page instead
           of replacing this card alone: hx-select makes HTMX ask for the whole page, and the page marks its heading
           autofocus when HTMX asked for it, so the keyboard and the window start the new page at its top, as a page
           loaded without HTMX would, and the heading's focus tells the user their change happened. Every other link and
           form in the card still replaces the card alone. *@
        <footer class="pager">
            <p class="summary">Showing <strong>@list.Items.Length.ToString("N0", CultureInfo.CurrentCulture)</strong> of <strong>@list.Matching.Value.ToString("N0", CultureInfo.CurrentCulture)</strong></p>
            <nav class="pages" aria-label="Pages">
                @if (list.Previous is OrganizationCursor previous)
                {
                    <a class="btn" rel="prev" asp-page="./Index" asp-all-route-data="Model.RouteValues(cursor: previous)" hx-target="#main" hx-select="#main"><svg class="icon" aria-hidden="true"><use href="/icons.svg#chevron-left"></use></svg>Previous</a>
                }
                else
                {
                    <span class="btn" aria-disabled="true"><svg class="icon" aria-hidden="true"><use href="/icons.svg#chevron-left"></use></svg>Previous</span>
                }
                @if (list.Next is OrganizationCursor next)
                {
                    <a class="btn" rel="next" asp-page="./Index" asp-all-route-data="Model.RouteValues(cursor: next)" hx-target="#main" hx-select="#main">Next<svg class="icon" aria-hidden="true"><use href="/icons.svg#chevron-right"></use></svg></a>
                }
                else
                {
                    <span class="btn" aria-disabled="true">Next<svg class="icon" aria-hidden="true"><use href="/icons.svg#chevron-right"></use></svg></span>
                }
            </nav>
            @* HTMX sends the brand's Rows per page form when the select changes; without HTMX its Apply button, which the
               brand's CSS shows only then, sends it. A new page size keeps the page where it is: the cursor rides
               along. *@
            <form class="page-size" method="get" hx-get="@Url.Page("./Index")" hx-trigger="change" hx-push-url="true"
                  hx-target="#main" hx-select="#main">
                <input type="hidden" name="@ListQuery.FilterKey" value="@current.Filter?.Value">
                <input type="hidden" name="@ListQuery.StatusKey" value="@current.Status.ToString().ToLowerInvariant()">
                <input type="hidden" name="@ListQuery.SortKey" value="@current.Sort.ToString().ToLowerInvariant()">
                <input type="hidden" name="@ListQuery.DirectionKey" value="@current.Direction.ToString().ToLowerInvariant()">
                @if (current.Cursor is OrganizationCursor cursor)
                {
                    <input type="hidden" name="@(cursor.Position == CursorPosition.After ? ListQuery.AfterKey : ListQuery.BeforeKey)" value="@cursor.Id.Value">
                }
                <label for="page-size">Rows per page</label>
                <select id="page-size" name="@ListQuery.PageSizeKey">
                    @foreach (int size in ListQuery.PageSizes)
                    {
                        <option value="@size" selected="@(size == current.PageSize.Value)">@size</option>
                    }
                </select>
                <button class="btn" type="submit">Apply</button>
            </form>
        </footer>
    }
</div>
