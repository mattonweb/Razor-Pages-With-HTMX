@model HTMX.Application.Web.Pages.Organizations.IndexModel
@using System.Globalization
@using HTMX.Adapter.Customers.Contracts
@{
    OrganizationCollectionResponse list = Model.Organizations;
    OrganizationCollectionRequest current = list.Request;
}
@* Every link and form in the card loads over HTMX: the response replaces the card itself, the URL follows, and
   the card shows the busy bar while a request is in flight. In HTMX 4 an attribute reaches the card's descendants
   only when it says :inherited, and "this" means the card that declares it. Without HTMX they are plain links
   and GET forms. *@
<div class="card" id="organization-list"
     hx-boost:inherited="true" hx-target:inherited="this" hx-swap:inherited="outerHTML"
     hx-indicator:inherited="#organization-list">
    <div class="toolbar">
        @* A GET form: typing a filter and pressing Enter loads the list again, keeping the status, sort and page size. *@
        <form class="filter-box" role="search" method="get">
            <svg class="icon" aria-hidden="true"><use href="/icons.svg#filter"></use></svg>
            @* As you type, 300ms after the last key; the id lets HTMX keep the cursor in the box across the swap. *@
            <input type="search" id="organization-filter" name="@IndexModel.FilterKey" value="@current.Filter?.Value"
                   placeholder="Filter organizations" aria-label="Filter organizations"
                   hx-get="@Url.Page("./Index")" hx-trigger="input changed delay:300ms, search" hx-include="closest form"
                   hx-push-url="true">
            <input type="hidden" name="@IndexModel.StatusKey" value="@current.Status.ToString().ToLowerInvariant()">
            <input type="hidden" name="@IndexModel.SortKey" value="@current.Sort.ToString().ToLowerInvariant()">
            <input type="hidden" name="@IndexModel.DirectionKey" value="@current.Direction.ToString().ToLowerInvariant()">
            <input type="hidden" name="@IndexModel.PageSizeKey" value="@current.PageSize.Value">
        </form>
        <nav class="segmented" aria-label="Show">
            <a asp-page="./Index" asp-all-route-data="Model.RouteValues(status: RecordStatus.Active)"
               aria-current="@(current.Status == RecordStatus.Active ? "page" : null)">Active <span class="count">@list.Active.Value.ToString("N0", CultureInfo.CurrentCulture)</span></a>
            <a asp-page="./Index" asp-all-route-data="Model.RouteValues(status: RecordStatus.Archived)"
               aria-current="@(current.Status == RecordStatus.Archived ? "page" : null)">Archived <span class="count">@list.Archived.Value.ToString("N0", CultureInfo.CurrentCulture)</span></a>
            <a asp-page="./Index" asp-all-route-data="Model.RouteValues(status: RecordStatus.All)"
               aria-current="@(current.Status == RecordStatus.All ? "page" : null)">All <span class="count">@list.All.Value.ToString("N0", CultureInfo.CurrentCulture)</span></a>
        </nav>
    </div>
    <div class="busy-bar"></div>

    @if (list.Matching.Value == 0)
    {
        <div class="empty">
            <svg class="icon" aria-hidden="true"><use href="/icons.svg#filter"></use></svg>
            <h3>No organizations match “@current.Filter?.Value”</h3>
            <p>Check the spelling, or filter by another word.</p>
            <a class="btn" asp-page="./Index" asp-all-route-data="Model.RouteValues(withoutFilter: true)">Clear filter</a>
        </div>
    }
    else
    {
        <div class="grid-wrap">
            <table class="grid">
                <caption class="visually-hidden">Organizations, @current.Status.ToString().ToLowerInvariant(), sorted by @current.Sort.ToString().ToLowerInvariant(), @current.Direction.ToString().ToLowerInvariant()</caption>
                <thead>
                    <tr>
                        <th scope="col" aria-sort="@Model.AriaSort(OrganizationSortColumn.Name)">
                            <a asp-page="./Index" asp-all-route-data="Model.SortRouteValues(OrganizationSortColumn.Name)">Name <partial name="_SortIcon" model="Model.AriaSort(OrganizationSortColumn.Name)" /></a>
                        </th>
                        <th scope="col" aria-sort="@Model.AriaSort(OrganizationSortColumn.Industry)">
                            <a asp-page="./Index" asp-all-route-data="Model.SortRouteValues(OrganizationSortColumn.Industry)">Industry <partial name="_SortIcon" model="Model.AriaSort(OrganizationSortColumn.Industry)" /></a>
                        </th>
                        <th scope="col" class="num" aria-sort="@Model.AriaSort(OrganizationSortColumn.Contacts)">
                            <a asp-page="./Index" asp-all-route-data="Model.SortRouteValues(OrganizationSortColumn.Contacts)">Contacts <partial name="_SortIcon" model="Model.AriaSort(OrganizationSortColumn.Contacts)" /></a>
                        </th>
                        <th scope="col">Status</th>
                        <th scope="col" aria-sort="@Model.AriaSort(OrganizationSortColumn.Updated)">
                            <a asp-page="./Index" asp-all-route-data="Model.SortRouteValues(OrganizationSortColumn.Updated)">Updated <partial name="_SortIcon" model="Model.AriaSort(OrganizationSortColumn.Updated)" /></a>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (OrganizationSummary organization in list.Items)
                    {
                        @* Archived rows are muted only among active ones, in the All view. *@
                        <tr class="@(current.Status == RecordStatus.All && organization.ArchivedOn is not null ? "archived" : null)">
                            <td class="title">
                                @* A link to the organization leaves the list, so it is a normal link, not a swap. *@
                                <a href="/organizations/@organization.Id.Value" hx-boost="false">@organization.Name.Value</a>
                                @if (organization.Website is WebAddress website)
                                {
                                    <span class="sub">@IndexModel.WebsiteHost(website)</span>
                                }
                            </td>
                            <td>@IndexModel.IndustryName(organization.Industry)</td>
                            <td class="num">@organization.Contacts.Value.ToString("N0", CultureInfo.CurrentCulture)</td>
                            <td>
                                @if (organization.ArchivedOn is null)
                                {
                                    <span class="chip success">Active</span>
                                }
                                else
                                {
                                    <span class="chip">Archived</span>
                                }
                            </td>
                            <td><time datetime="@organization.LastModifiedOn.ToString("O", CultureInfo.InvariantCulture)">@organization.LastModifiedOn.ToLocalTime().ToString("d MMM yyyy", CultureInfo.CurrentCulture)</time></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* Key-based paging knows the total and whether there is a page either side, not where in the list this page
           starts, so the summary gives the count shown and the total. *@
        <footer class="pager">
            <p class="summary">Showing <strong>@list.Items.Length.ToString("N0", CultureInfo.CurrentCulture)</strong> of <strong>@list.Matching.Value.ToString("N0", CultureInfo.CurrentCulture)</strong></p>
            <nav class="pages" aria-label="Pages">
                @if (list.Previous is OrganizationCursor previous)
                {
                    <a class="btn" rel="prev" asp-page="./Index" asp-all-route-data="Model.RouteValues(cursor: previous)"><svg class="icon" aria-hidden="true"><use href="/icons.svg#chevron-left"></use></svg>Previous</a>
                }
                else
                {
                    <span class="btn" aria-disabled="true"><svg class="icon" aria-hidden="true"><use href="/icons.svg#chevron-left"></use></svg>Previous</span>
                }
                @if (list.Next is OrganizationCursor next)
                {
                    <a class="btn" rel="next" asp-page="./Index" asp-all-route-data="Model.RouteValues(cursor: next)">Next<svg class="icon" aria-hidden="true"><use href="/icons.svg#chevron-right"></use></svg></a>
                }
                else
                {
                    <span class="btn" aria-disabled="true">Next<svg class="icon" aria-hidden="true"><use href="/icons.svg#chevron-right"></use></svg></span>
                }
            </nav>
            @* The brand's Rows per page form has no button: HTMX sends it when the select changes. *@
            @* A new page size keeps the page where it is: the cursor rides along. *@
            <form class="page-size" method="get" hx-get="@Url.Page("./Index")" hx-trigger="change" hx-push-url="true">
                <input type="hidden" name="@IndexModel.FilterKey" value="@current.Filter?.Value">
                <input type="hidden" name="@IndexModel.StatusKey" value="@current.Status.ToString().ToLowerInvariant()">
                <input type="hidden" name="@IndexModel.SortKey" value="@current.Sort.ToString().ToLowerInvariant()">
                <input type="hidden" name="@IndexModel.DirectionKey" value="@current.Direction.ToString().ToLowerInvariant()">
                @if (current.Cursor is OrganizationCursor cursor)
                {
                    <input type="hidden" name="@(cursor.Position == CursorPosition.After ? IndexModel.AfterKey : IndexModel.BeforeKey)" value="@cursor.Id.Value">
                }
                <label for="page-size">Rows per page</label>
                <select id="page-size" name="@IndexModel.PageSizeKey">
                    @foreach (int size in Model.PageSizeOptions)
                    {
                        <option value="@size" selected="@(size == current.PageSize.Value)">@size</option>
                    }
                </select>
            </form>
        </footer>
    }
</div>
