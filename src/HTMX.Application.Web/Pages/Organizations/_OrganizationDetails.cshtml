@model HTMX.Application.Web.Pages.Organizations.DetailsModel
@using System.Globalization
@using HTMX.Adapter.Customers.Contracts
@*
    The organization's page: its header, the alert that says it is archived, and its details. HTMX replaces
    #organization-details whole (outerHTML) with it after Archive, Restore or Undo, as part of
    _OrganizationStatusChanged. Archive and Restore post to the page's named handlers, with HTMX or without it, and
    their buttons share the id status-action, so that HTMX puts the focus back on whichever the new content holds.
    Neither says hx-disable: a disabled button loses the focus, and HTMX would have none to put back. The busy style
    that hx-indicator turns on already stops a second click.
*@
@{
    OrganizationSingleResponse organization = Model.Organization
        ?? throw new InvalidOperationException("The organization's page needs the organization.");
    RecordChange lastChange = organization.LastModified;
    RecordChange created = organization.Created;
    long id = organization.Id.Value;
    string? archiveAction = Url.Page("./Details", "Archive", new { id });
    string? restoreAction = Url.Page("./Details", "Restore", new { id });
}
<div id="organization-details">
    <header class="page-header">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
            <ol><li><a asp-page="/Index">Home</a></li><li><a asp-page="./Index">Organizations</a></li><li><span aria-current="page">@organization.Name.Value</span></li></ol>
        </nav>
        <div class="title-row">
            <div class="title">
                <h1>@organization.Name.Value</h1>
                @if (organization.Archived is null)
                {
                    <span class="chip success">Active</span>
                }
                else
                {
                    <span class="chip">Archived</span>
                }
                <span class="version current">v@(organization.Version.Value)</span>
            </div>
            @* An archived organization is closed to edits until it is restored, so it offers no Edit; its alert holds Restore. *@
            @if (organization.Archived is null)
            {
                <div class="btn-group">
                    <form method="post" action="@archiveAction" asp-antiforgery="true"
                          hx-post="@archiveAction" hx-target="#organization-details" hx-swap="outerHTML"
                          hx-indicator="find button">
                        <button class="btn" id="status-action" type="submit"><svg class="icon" aria-hidden="true"><use href="/icons.svg#archive"></use></svg>Archive</button>
                    </form>
                    <a class="btn primary" asp-page="./Edit" asp-route-id="@id"><svg class="icon" aria-hidden="true"><use href="/icons.svg#edit"></use></svg>Edit</a>
                </div>
            }
        </div>
        @* Users have no page of their own yet, so who changed the organization is a name, not a link. *@
        <p class="muted">Updated <partial name="_Moment" model="lastChange.On" /> by @lastChange.By.Name.Value</p>
    </header>

    @if (organization.Archived is not null)
    {
        <div class="alert" role="status">
            <svg class="icon" aria-hidden="true"><use href="/icons.svg#archive"></use></svg>
            <div class="content"><p><strong>This organization is archived.</strong> It is hidden from the active list and can't be edited until it is restored.</p></div>
            <div class="actions">
                <form method="post" action="@restoreAction" asp-antiforgery="true"
                      hx-post="@restoreAction" hx-target="#organization-details" hx-swap="outerHTML"
                      hx-indicator="find button">
                    <button class="btn" id="status-action" type="submit"><svg class="icon" aria-hidden="true"><use href="/icons.svg#restore"></use></svg>Restore</button>
                </form>
            </div>
        </div>
    }

    <section class="card" aria-labelledby="details-heading">
        <header class="card-header"><h2 id="details-heading">Details</h2></header>
        <div class="card-body">
            <dl class="fields">
                <div><dt>Industry</dt><dd>@IndustryNames.Of(organization.Industry)</dd></div>
                <div>
                    <dt>Website</dt>
                    @if (organization.Website is WebAddress website)
                    {
                        <dd><a href="@website.Value">@website.Value</a></dd>
                    }
                    else
                    {
                        <dd><span class="unset">Not set</span></dd>
                    }
                </div>
                <div><dt>Contacts</dt><dd class="mono">@organization.Contacts.Value.ToString("N0", CultureInfo.CurrentCulture)</dd></div>
                <div><dt>Identifier</dt><dd class="mono">@id</dd></div>
                <div><dt>Created</dt><dd><partial name="_Moment" model="created.On" /> by @created.By.Name.Value</dd></div>
                @if (organization.Archived is RecordChange archived)
                {
                    <div><dt>Archived</dt><dd><partial name="_Moment" model="archived.On" /> by @archived.By.Name.Value</dd></div>
                }
            </dl>
        </div>
    </section>
</div>
