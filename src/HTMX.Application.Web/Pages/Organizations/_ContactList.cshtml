@model HTMX.Application.Web.Pages.Organizations.ContactsModel
@using System.Globalization
@using HTMX.Adapter.Customers.Contracts
@*
    The Contacts tab's list: one card, which the tab renders and an action on a row draws again. Every link and form in
    the card loads over HTMX; in HTMX 4 an attribute reaches the card's descendants only when it says :inherited.
    Previous and Next are boosted links, so the URL follows them, and they replace the tab's whole content,
    #organization: the header's Archive and Restore post to the URL's values, so they must be drawn again whenever the
    URL changes. A row's form replaces #organization too, because its toast's Undo can be pressed after Next and draws
    the page where the action ran, which changes the URL back. It says hx-post, which HTMX sets up before it boosts
    anything, so the post is not boosted. Every request in the card joins one queue on the card, and the newest
    replaces the one running, so a slow answer never lands after a newer one. Without HTMX they are plain links and
    forms that post.

    New contact, the card's one action, opens the create form with this organization chosen. It leaves the list, so it
    loads the whole page, as the layout's links do, rather than replacing #organization; an archived organization,
    which takes no one in, does not offer it.

    An archived contact's menu ends with Delete permanently, which cannot be undone, so it opens a confirm dialog whose
    own form posts to the list's address with the version the row shows. A delete changes the count on the Contacts
    tab's label, which the tab's whole content, #organization, holds. The dialogs come after the table: after a swap
    HTMX focuses only the first element that says autofocus, and each dialog's Cancel says it, so the row's menu
    button, or the heading once a delete leaves no row, must come first.
*@
@{
    OrganizationSingleResponse organization = Model.Organization
        ?? throw new InvalidOperationException("The list of contacts needs the organization.");
    ContactCollectionResponse list = Model.Contacts
        ?? throw new InvalidOperationException("The list of contacts needs the page of contacts.");

    // An archived organization's contacts can be seen but not changed until it is restored, so its rows have no
    // actions.
    bool changeable = organization.Archived is null;
}
<section class="card" id="contact-list" aria-labelledby="contacts-heading"
         hx-boost:inherited="true" hx-target:inherited="#organization" hx-swap:inherited="outerHTML"
         hx-indicator:inherited="#contact-list" hx-sync:inherited="this:replace">
    <header class="card-header">
        <h2 id="contacts-heading" tabindex="-1" autofocus="@Model.ListHeadingFocused">Contacts</h2>
        @if (changeable)
        {
            <a class="btn ghost" asp-page="/Contacts/Create" asp-route-organization="@organization.Id.Value" hx-target="body" hx-swap="innerHTML"><svg class="icon" aria-hidden="true"><use href="/icons.svg#plus"></use></svg>New contact</a>
        }
    </header>
    <div class="busy-bar"></div>

    @if (list.Total.Value == 0)
    {
        <div class="empty">
            <svg class="icon" aria-hidden="true"><use href="/icons.svg#users"></use></svg>
            <h3>No contacts yet</h3>
            <p>Nobody at @organization.Name.Value is on record.</p>
        </div>
    }
    else
    {
        <div class="grid-wrap">
            <table class="grid">
                <caption class="visually-hidden">Contacts at @organization.Name.Value, sorted by name</caption>
                <thead>
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col">Email</th>
                        <th scope="col">Phone</th>
                        <th scope="col">Status</th>
                        @if (changeable)
                        {
                            <th scope="col"><span class="visually-hidden">Actions</span></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (ContactSummary contact in list.Items)
                    {
                        bool archived = contact.ArchivedOn is not null;
                        string menu = $"contact-{contact.Id.Value}-menu";
                        <tr class="@(archived ? "archived" : null)">
                            @* A link to the contact leaves the list, so it loads the whole page, as New contact
                               does. *@
                            <td class="title">
                                <a asp-page="/Contacts/Details" asp-route-id="@contact.Id.Value" hx-target="body" hx-swap="innerHTML">@contact.Name.Value</a>
                                @if (contact.JobTitle is JobTitle jobTitle)
                                {
                                    <span class="sub">@jobTitle.Value</span>
                                }
                            </td>
                            <td>
                                @if (contact.Email is EmailAddress email)
                                {
                                    <a href="mailto:@email.Value">@email.Value</a>
                                }
                            </td>
                            <td>@contact.Phone?.Value</td>
                            <td>
                                @if (archived)
                                {
                                    <span class="chip">Archived</span>
                                }
                                else
                                {
                                    <span class="chip success">Active</span>
                                }
                            </td>
                            @if (changeable)
                            {
                                string action = Model.RowAction(contact);
                                @* The row's menu, a popover with an id built from the contact's. Once the answer
                                   has drawn the list again, HTMX focuses the element that says autofocus: this row's
                                   menu button. *@
                                <td class="actions">
                                    <button class="btn ghost icon-only" type="button" popovertarget="@menu"
                                            aria-label="Actions for @contact.Name.Value"
                                            autofocus="@(Model.Focused == contact.Id)">
                                        <svg class="icon" aria-hidden="true"><use href="/icons.svg#more"></use></svg>
                                    </button>
                                    <div class="menu" id="@menu" popover>
                                        <form method="post" action="@action" asp-antiforgery="true"
                                              hx-post="@action" hx-target="#organization">
                                            @if (archived)
                                            {
                                                <button type="submit"><svg class="icon" aria-hidden="true"><use href="/icons.svg#restore"></use></svg>Restore</button>
                                            }
                                            else
                                            {
                                                <button type="submit"><svg class="icon" aria-hidden="true"><use href="/icons.svg#archive"></use></svg>Archive</button>
                                            }
                                        </form>
                                        @if (archived)
                                        {
                                            <hr>
                                            <button class="danger" type="button" commandfor="contact-@(contact.Id.Value)-delete" command="show-modal"><svg class="icon" aria-hidden="true"><use href="/icons.svg#trash"></use></svg>Delete permanently</button>
                                        }
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (changeable)
        {
            foreach (ContactSummary contact in list.Items.Where(static contact => contact.ArchivedOn is not null))
            {
                string dialog = $"contact-{contact.Id.Value}-delete";
                string deleteAction = Model.DeleteAction(contact);
                <dialog class="dialog sm" id="@dialog" aria-labelledby="@(dialog)-title" aria-describedby="@(dialog)-text">
                    <form method="post" action="@deleteAction" asp-antiforgery="true"
                          hx-post="@deleteAction" hx-target="#organization"
                          hx-indicator="find button[type=submit]" hx-disable="find button[type=submit]">
                        <input type="hidden" name="version" value="@contact.Version.Value" />
                        <header class="dialog-header"><h2 id="@(dialog)-title">Delete @contact.Name.Value permanently?</h2></header>
                        <div class="dialog-body confirm">
                            <span class="dialog-icon"><svg class="icon" aria-hidden="true"><use href="/icons.svg#trash"></use></svg></span>
                            <div class="message" id="@(dialog)-text"><p>This removes @contact.Name.Value and their history, and takes them off this list. It cannot be undone.</p></div>
                        </div>
                        <footer class="dialog-footer">
                            <button class="btn" type="button" commandfor="@dialog" command="close" autofocus>Cancel</button>
                            <button class="btn danger" type="submit">Delete permanently</button>
                        </footer>
                    </form>
                </dialog>
            }
        }

        @* A pager with nowhere to go is left out. Key-based paging knows the total and whether there is a page either
           side, not where in the list this page starts, so the summary gives the count shown and the total. *@
        @if (list.Previous is not null || list.Next is not null)
        {
            <footer class="pager">
                <p class="summary">Showing <strong>@list.Items.Length.ToString("N0", CultureInfo.CurrentCulture)</strong> of <strong>@list.Total.Value.ToString("N0", CultureInfo.CurrentCulture)</strong></p>
                <nav class="pages" aria-label="Pages">
                    @if (list.Previous is ContactCursor previous)
                    {
                        <a class="btn" rel="prev" asp-page="./Contacts" asp-all-route-data="Model.PageValues(previous)"><svg class="icon" aria-hidden="true"><use href="/icons.svg#chevron-left"></use></svg>Previous</a>
                    }
                    else
                    {
                        <span class="btn" aria-disabled="true"><svg class="icon" aria-hidden="true"><use href="/icons.svg#chevron-left"></use></svg>Previous</span>
                    }
                    @if (list.Next is ContactCursor next)
                    {
                        <a class="btn" rel="next" asp-page="./Contacts" asp-all-route-data="Model.PageValues(next)">Next<svg class="icon" aria-hidden="true"><use href="/icons.svg#chevron-right"></use></svg></a>
                    }
                    else
                    {
                        <span class="btn" aria-disabled="true">Next<svg class="icon" aria-hidden="true"><use href="/icons.svg#chevron-right"></use></svg></span>
                    }
                </nav>
            </footer>
        }
    }
</section>
