@page "/organizations/{id:long}"
@model HTMX.Application.Web.Pages.Organizations.DetailsModel
@{
    ViewData["Title"] = Model.Organization?.Name.Value ?? "Organization not found";
    ViewData["Section"] = "Organizations";
}
@* The page's route is written out in full, so an organization's address is /organizations/10003. *@

@if (Model.Organization is null)
{
    <partial name="_OrganizationNotFound"
             model="new MissingRecord { Id = Model.Input.Id, HeadingFocused = Model.HeadingFocused }" />
}
else
{
    <partial name="_OrganizationDetails" model="Model" />
}

@* After Archive, Restore or Undo without HTMX, the redirect's page shows the toast the action left. *@
@section Toasts {
    @if (Model.Toast is Toast toast)
    {
        <partial name="_Toast" model="toast" />
    }
}
