@model MissingRecord
@*
    What a user's pages show for an identifier that names no user, inside the application's frame. The page that
    renders it also sets the status 404 Not Found. Its model is the identifier from the route, and whether the heading
    takes the focus, as when a link HTMX loads leads here.
*@
<header page-header>
    <nav breadcrumbs aria-label="Breadcrumb">
        <ol><li><a asp-page="/Index">Home</a></li><li><a asp-page="./Index">Users</a></li><li><span aria-current="page">Not found</span></li></ol>
    </nav>
    <div page-header="title-row"><h1 tabindex="-1" autofocus="@Model.HeadingFocused">User not found</h1></div>
</header>

<div card>
    <div empty-state>
        <icon name="user" />
        <h3>No user has the identifier @Model.Id</h3>
        <p>They may have been deleted, or the link may be mistyped.</p>
        <a button="secondary" asp-page="./Index">Back to users</a>
    </div>
</div>
