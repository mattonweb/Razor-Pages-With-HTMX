@page
@model HTMX.Application.Web.Pages.Users.IndexModel
@{
    ViewData["Title"] = "Users";
    ViewData["Section"] = "Users";
}

<header class="page-header">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol><li><a asp-page="/Index">Home</a></li><li><span aria-current="page">Users</span></li></ol>
    </nav>
    <div class="title-row">
        <h1 tabindex="-1" autofocus="@Model.HeadingFocused">Users</h1>
        <a class="btn primary" asp-page="./Create"><svg class="icon" aria-hidden="true"><use href="/icons.svg#plus"></use></svg>New user</a>
    </div>
</header>

@* The list's card is a partial: the page renders it here, and the handler sends it alone to an HTMX request. *@
<partial name="_UserList" model="Model" />

@* After a user is deleted, their page comes here, by a redirect or by HX-Location, and the toast it left shows. *@
@section Toasts {
    @if (Model.Toast is Toast toast)
    {
        <partial name="_Toast" model="toast" />
    }
}
