@model HTMX.Application.Web.Pages.Users.IndexModel
@using System.Globalization
@using HTMX.Adapter.Customers.Contracts
@{
    UserCollectionResponse list = Model.Users;
    UserCollectionRequest current = list.Request;
}
@* The users list's card, built as the organizations list's is. Every link and form in the card loads over HTMX: the
   response replaces the card itself, the URL follows, and the card shows the busy bar while a request is in flight.
   In HTMX 4 an attribute reaches the card's descendants only when it says :inherited, and "this" means the card that
   declares it. Every request in the card joins one queue on the card, and the newest replaces the one running, so a
   slow answer to an older filter, sort or page never lands after a newer one; without hx-sync each element would keep
   its own queue, and HTMX 4 drops a third request while one runs and one waits. Without HTMX they are plain links and
   GET forms. *@
<div class="card" id="user-list"
     hx-boost:inherited="true" hx-target:inherited="this" hx-swap:inherited="outerHTML"
     hx-indicator:inherited="#user-list" hx-sync:inherited="this:replace">
    <div class="toolbar">
        @* A GET form: typing a filter and pressing Enter loads the list again, keeping the status, sort and page size.
           Apply sends it too; the brand's CSS shows it only without HTMX, for a pointer. *@
        <form class="filter-box" role="search" method="get">
            <svg class="icon" aria-hidden="true"><use href="/icons.svg#filter"></use></svg>
            @* As you type, 300ms after the last key; the id lets HTMX keep the cursor in the box across the swap. *@
            <input type="search" id="user-filter" name="@ListQuery.FilterKey" value="@current.Filter?.Value"
                   placeholder="Filter users" aria-label="Filter users by name, username or email"
                   hx-get="@Url.Page("./Index")" hx-trigger="input changed delay:300ms, search" hx-include="closest form"
                   hx-push-url="true">
            <input type="hidden" name="@ListQuery.StatusKey" value="@ListQuery.Name(current.Status)">
            <input type="hidden" name="@ListQuery.SortKey" value="@ListQuery.Name(current.Sort)">
            <input type="hidden" name="@ListQuery.DirectionKey" value="@ListQuery.Name(current.Direction)">
            <input type="hidden" name="@ListQuery.PageSizeKey" value="@current.PageSize.Value">
            <button class="btn" type="submit">Apply</button>
        </form>
        <nav class="segmented" aria-label="Show">
            <a asp-page="./Index" asp-all-route-data="Model.RouteValues(status: RecordStatus.Active)"
               aria-current="@(current.Status == RecordStatus.Active ? "page" : null)">Active <span class="count">@list.Active.Value.ToString("N0", CultureInfo.CurrentCulture)</span></a>
            <a asp-page="./Index" asp-all-route-data="Model.RouteValues(status: RecordStatus.Archived)"
               aria-current="@(current.Status == RecordStatus.Archived ? "page" : null)">Archived <span class="count">@list.Archived.Value.ToString("N0", CultureInfo.CurrentCulture)</span></a>
            <a asp-page="./Index" asp-all-route-data="Model.RouteValues(status: RecordStatus.All)"
               aria-current="@(current.Status == RecordStatus.All ? "page" : null)">All <span class="count">@list.All.Value.ToString("N0", CultureInfo.CurrentCulture)</span></a>
        </nav>
    </div>
    <div class="busy-bar"></div>

    @if (list.Matching.Value == 0)
    {
        <div class="empty">
            <svg class="icon" aria-hidden="true"><use href="/icons.svg#filter"></use></svg>
            <h3>No users match “@current.Filter?.Value”</h3>
            <p>Check the spelling, or filter by another word. The filter looks in names, usernames and email addresses.</p>
            <a class="btn" asp-page="./Index" asp-all-route-data="Model.RouteValues(withoutFilter: true)">Clear filter</a>
        </div>
    }
    else
    {
        <div class="grid-wrap">
            <table class="grid">
                <caption class="visually-hidden">Users, @ListQuery.Name(current.Status), sorted by @ListQuery.Name(current.Sort), @ListQuery.Name(current.Direction)</caption>
                <thead>
                    <tr>
                        <th scope="col" aria-sort="@Model.AriaSort(UserSortColumn.Name)">
                            <a asp-page="./Index" asp-all-route-data="Model.SortRouteValues(UserSortColumn.Name)">Name <partial name="_SortIcon" model="Model.AriaSort(UserSortColumn.Name)" /></a>
                        </th>
                        <th scope="col" aria-sort="@Model.AriaSort(UserSortColumn.Username)">
                            <a asp-page="./Index" asp-all-route-data="Model.SortRouteValues(UserSortColumn.Username)">Username <partial name="_SortIcon" model="Model.AriaSort(UserSortColumn.Username)" /></a>
                        </th>
                        <th scope="col" aria-sort="@Model.AriaSort(UserSortColumn.Email)">
                            <a asp-page="./Index" asp-all-route-data="Model.SortRouteValues(UserSortColumn.Email)">Email <partial name="_SortIcon" model="Model.AriaSort(UserSortColumn.Email)" /></a>
                        </th>
                        <th scope="col">Status</th>
                        <th scope="col" aria-sort="@Model.AriaSort(UserSortColumn.Updated)">
                            <a asp-page="./Index" asp-all-route-data="Model.SortRouteValues(UserSortColumn.Updated)">Updated <partial name="_SortIcon" model="Model.AriaSort(UserSortColumn.Updated)" /></a>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (UserSummary user in list.Items)
                    {
                        @* Archived rows are muted only among active ones, in the All view. *@
                        <tr class="@(current.Status == RecordStatus.All && user.ArchivedOn is not null ? "archived" : null)">
                            <td class="title">
                                @* A link to the user leaves the list, so it loads the whole page, as the layout's
                                   links do, rather than replacing the card. *@
                                <a asp-page="./Details" asp-route-id="@user.Id.Value" hx-target="body" hx-swap="innerHTML">@user.DisplayName.Value</a>
                            </td>
                            <td class="mono">@user.Username.Value</td>
                            <td><a href="mailto:@user.Email.Value">@user.Email.Value</a></td>
                            <td>
                                @if (user.ArchivedOn is null)
                                {
                                    <span class="chip success">Active</span>
                                }
                                else
                                {
                                    <span class="chip">Archived</span>
                                }
                            </td>
                            <td><time datetime="@user.LastModifiedOn.ToString("O", CultureInfo.InvariantCulture)">@user.LastModifiedOn.ToLocalTime().ToString("d MMM yyyy", CultureInfo.CurrentCulture)</time></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* Key-based paging knows the total and whether there is a page either side, not where in the list this page
           starts, so the summary gives the count shown and the total.

           Previous, Next and Rows per page take the page's main content, heading and all, from the whole page instead
           of replacing this card alone: hx-select makes HTMX ask for the whole page, and the page marks its heading
           autofocus when HTMX asked for it, so the keyboard and the window start the new page at its top, as a page
           loaded without HTMX would, and the heading's focus tells the user their change happened. Every other link and
           form in the card still replaces the card alone. *@
        <footer class="pager">
            <p class="summary">Showing <strong>@list.Items.Length.ToString("N0", CultureInfo.CurrentCulture)</strong> of <strong>@list.Matching.Value.ToString("N0", CultureInfo.CurrentCulture)</strong></p>
            <nav class="pages" aria-label="Pages">
                @if (list.Previous is UserCursor previous)
                {
                    <a class="btn" rel="prev" asp-page="./Index" asp-all-route-data="Model.RouteValues(cursor: previous)" hx-target="#main" hx-select="#main"><svg class="icon" aria-hidden="true"><use href="/icons.svg#chevron-left"></use></svg>Previous</a>
                }
                else
                {
                    <span class="btn" aria-disabled="true"><svg class="icon" aria-hidden="true"><use href="/icons.svg#chevron-left"></use></svg>Previous</span>
                }
                @if (list.Next is UserCursor next)
                {
                    <a class="btn" rel="next" asp-page="./Index" asp-all-route-data="Model.RouteValues(cursor: next)" hx-target="#main" hx-select="#main">Next<svg class="icon" aria-hidden="true"><use href="/icons.svg#chevron-right"></use></svg></a>
                }
                else
                {
                    <span class="btn" aria-disabled="true">Next<svg class="icon" aria-hidden="true"><use href="/icons.svg#chevron-right"></use></svg></span>
                }
            </nav>
            @* HTMX sends the brand's Rows per page form when the select changes; without HTMX its Apply button, which the
               brand's CSS shows only then, sends it. A new page size keeps the page where it is: the cursor rides
               along. *@
            <form class="page-size" method="get" hx-get="@Url.Page("./Index")" hx-trigger="change" hx-push-url="true"
                  hx-target="#main" hx-select="#main">
                <input type="hidden" name="@ListQuery.FilterKey" value="@current.Filter?.Value">
                <input type="hidden" name="@ListQuery.StatusKey" value="@ListQuery.Name(current.Status)">
                <input type="hidden" name="@ListQuery.SortKey" value="@ListQuery.Name(current.Sort)">
                <input type="hidden" name="@ListQuery.DirectionKey" value="@ListQuery.Name(current.Direction)">
                @if (current.Cursor is UserCursor cursor)
                {
                    <input type="hidden" name="@(cursor.Position == CursorPosition.After ? ListQuery.AfterKey : ListQuery.BeforeKey)" value="@cursor.Id.Value">
                }
                <label for="page-size">Rows per page</label>
                <select id="page-size" name="@ListQuery.PageSizeKey">
                    @foreach (int size in ListQuery.PageSizes)
                    {
                        <option value="@size" selected="@(size == current.PageSize.Value)">@size</option>
                    }
                </select>
                <button class="btn" type="submit">Apply</button>
            </form>
        </footer>
    }
</div>
